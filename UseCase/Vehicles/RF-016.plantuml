@startuml RF-016
!pragma layout smetana
skinparam actorStyle awesome
left to right direction 

title Caso de uso: RF-016 - Consultar listado de flota

' Convencion de color reutilizable en todos los diagramas de RF de FloatOps
skinparam usecase {
  BackgroundColor<<Alta>> LightSkyBlue
  BorderColor<<Alta>> SteelBlue
  BackgroundColor<<Media>> Khaki
  BorderColor<<Media>> DarkKhaki
  BackgroundColor<<Baja>> Gainsboro
  BorderColor<<Baja>> Gray
  ArrowColor SteelBlue
}

actor Administrador
actor Despachador

package "vehicles" {
    usecase UC1 as "Consultar listado de flota" <<Alta>>
}

Administrador --> UC1 : consulta
Despachador --> UC1 : consulta

note right of UC1
  **RF-016** - Prioridad: Alta
  --
  Criterios de aceptacion:
  * Incluye filtros por estado:
  atrasado, proximo a vencer, programado
end note

@enduml