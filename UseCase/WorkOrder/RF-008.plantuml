@startuml RF-008
!pragma layout smetana
skinparam actorStyle awesome
left to right direction

title Caso de uso: RF-008 - Asignar tecnico al crear la orden

skinparam usecase {
  BackgroundColor<<Alta>> LightSkyBlue
  BorderColor<<Alta>> SteelBlue
  BackgroundColor<<Media>> Khaki
  BorderColor<<Media>> DarkKhaki
  BackgroundColor<<Baja>> Gainsboro
  BorderColor<<Baja>> Gray
  ArrowColor SteelBlue
}

actor Despachador
actor Administrador

package "Ordenes de trabajo" {
  usecase UC1 as "Asignar tecnico\nal crear la orden\n--\nAsigna un tecnico a la orden\nen el momento de su creacion." <<Alta>>
}

Despachador --> UC1
Administrador --> UC1

note right of UC1
  **RF-008** - Prioridad: Alta
  --
  Criterios de aceptacion:
  * El campo tecnico asignado queda disponible al crear la orden
end note

@enduml
