@startuml RF-010
!pragma layout smetana
skinparam actorStyle awesome
left to right direction

title Caso de uso: RF-010 - Calcular presupuesto de la orden

skinparam usecase {
  BackgroundColor<<Alta>> LightSkyBlue
  BorderColor<<Alta>> SteelBlue
  BackgroundColor<<Media>> Khaki
  BorderColor<<Media>> DarkKhaki
  BackgroundColor<<Baja>> Gainsboro
  BorderColor<<Baja>> Gray
  ArrowColor SteelBlue
}

actor Despachador
actor Administrador

package "Ordenes de trabajo" {
  usecase UC1 as "Calcular presupuesto\nde la orden\n--\nCalcula automaticamente el\npresupuesto (estimado,\nrepuestos, restante)." <<Alta>>
}

Despachador --> UC1
Administrador --> UC1

note right of UC1
  **RF-010** - Prioridad: Alta
  --
  Criterios de aceptacion:
  * El total se recalcula al marcar o desmarcar un repuesto
end note

@enduml
