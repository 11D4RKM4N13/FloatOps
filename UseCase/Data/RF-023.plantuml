@startuml RF-023
!pragma layout smetana
skinparam actorStyle awesome
left to right direction

title Caso de uso: RF-023 - Generar informes

skinparam usecase {
  BackgroundColor<<Alta>> LightSkyBlue
  BorderColor<<Alta>> SteelBlue
  BackgroundColor<<Media>> Khaki
  BorderColor<<Media>> DarkKhaki
  BackgroundColor<<Baja>> Gainsboro
  BorderColor<<Baja>> Gray
  ArrowColor SteelBlue
}

actor Despachador
actor Administrador

package "Informes" {
  usecase UC1 as "Generar informes\n--\nGenera informes a partir de\nlos datos almacenados (ordenes,\ntecnicos, repuestos, vehiculos)." <<Media>>
}

Despachador --> UC1
Administrador --> UC1

note right of UC1
  **RF-023** - Prioridad: Media
  --
  Criterios de aceptacion:
  * Alcance especifico de reportes pendiente de definir
end note

@enduml