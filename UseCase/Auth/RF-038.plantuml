@startuml RF-038
!pragma layout smetana
skinparam actorStyle awesome
left to right direction

title Caso de uso: RF-038 - Cerrar sesion

skinparam usecase {
  BackgroundColor<<Alta>> LightSkyBlue
  BorderColor<<Alta>> SteelBlue
  BackgroundColor<<Media>> Khaki
  BorderColor<<Media>> DarkKhaki
  BackgroundColor<<Baja>> Gainsboro
  BorderColor<<Baja>> Gray
  ArrowColor SteelBlue
}

actor Administrador
actor Despachador
actor Tecnico

package "Autenticacion y roles" {
  usecase UC1 as "Cerrar sesion\n--\nPermite a cualquier usuario\nautenticado cerrar su sesion." <<Alta>>
}

Administrador --> UC1
Despachador --> UC1
Tecnico --> UC1

note right of UC1
  **RF-038** - Prioridad: Alta
  --
  Criterios de aceptacion:
  * Caso de uso implicito de todo sistema con login
  * No tenia RF asignado hasta esta revision
end note

@enduml